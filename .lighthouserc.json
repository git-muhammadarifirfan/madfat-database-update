{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": ["--no-sandbox", "--disable-gpu"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "cumululative-layout-shift": ["error", {"minScore": 0.9}],
        "largest-contentful-paint": ["error", {"minScore": 0.9}],
        "first-contentful-paint": ["error", {"minScore": 0.9}],
        "performance": ["warn", {"minScore": 0.9}],
        "accessibility": ["warn", {"minScore": 0.95}],
        "best-practices": ["warn", {"minScore": 0.95}],
        "seo": ["warn", {"minScore": 0.95}]
      }
    }
  }
}
